{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@streamlinelabs/sdk": ["./src/index.ts"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["examples/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
